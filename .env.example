# Copy to .env and fill in. Never commit .env.
# Local: the Postgres from docker-compose.yml (docker compose up -d).
# Replit: do not set it here; adding Replit PostgreSQL sets DATABASE_URL in Secrets.
DATABASE_URL="postgresql://orbyte:orbyte@localhost:5433/orbyte"

# Any OpenAI-compatible chat-completions endpoint (team decision D5).
# Leave LLM_API_KEY empty to run without AI: extraction then returns "AI not configured"
# and the user enters payment dates manually. Figures never depend on AI.
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL=""
# "true" turns off hidden reasoning on models that support it (NVIDIA Nemotron); leave empty for OpenAI.
LLM_DISABLE_THINKING=""
